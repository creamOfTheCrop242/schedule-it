# Database (use DATABASE_URL or DB_* vars)
# DATABASE_URL=postgresql://user:password@host:5432/database
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=your_db_user
# DB_PASSWORD=your_db_password
# DB_NAME=your_db_name
# DB_SSL=true

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Email
ELASTIC_MAIL_PASSWORD=your_elastic_mail_password_here

# Facebook OAuth
FACEBOOK_APP_ID=your_facebook_app_id_here
FACEBOOK_APP_SECRET=your_facebook_app_secret_here

# JWT
JWT_SECRET=your_jwt_secret_here

# Server
PORT=3000
NODE_ENV=development

# Local QA only: soft-delete all logs + clear stored summaries for the logged-in user.
# Requires NODE_ENV not be `production`, JWT session, and header X-Dev-Onboarding-Reset matching this value.
# Match the same string in guide-log-frontend `environment.development.ts` (devOnboardingResetSecret).
# Leave unset in production. Note: `nest start` does not set NODE_ENV; unset is OK as long as it is not production.
DEV_ONBOARDING_RESET_SECRET=local-dev-onboarding-reset

# Comma-separated; can view GET /feedback (feedback inbox)
FEEDBACK_ADMIN_EMAILS=dhudson0242@gmail.com

# OpenAI (stored period summaries, daily motivation, voice draft)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
# Log AI summary only: lower reasoning = faster (omit | off = leave default model behavior)
OPENAI_LOG_SUMMARY_REASONING_EFFORT=low
# Cap model output tokens for summaries (256–4096)
OPENAI_LOG_SUMMARY_MAX_OUTPUT_TOKENS=1200

# Voice log POST /logs/voice-draft: Whisper transcription + structured draft (name, mood, description, surroundings, transcript; OPENAI_MODEL used as fallback text model if unset)
OPENAI_VOICE_LOG_MODEL=gpt-4o-mini
OPENAI_TRANSCRIPTION_MODEL=whisper-1

# Stored log period summaries (GET /logs/summaries). Cron runs daily when enabled.
SUMMARY_CRON_ENABLED=false
# Optional 5-field cron (default 10:00 UTC daily)
# SUMMARY_CRON_EXPRESSION=0 10 * * *
# Max logs per period batch (50–500)
# LOG_PERIOD_SUMMARY_MAX_LOGS=400
# Heroku Scheduler / ops: POST /internal/log-summaries/run with header X-Internal-Cron-Secret
# INTERNAL_CRON_SECRET=
# Re-enable legacy GET /logs/ai-summary (on-demand, filtered list)
# LEGACY_ON_DEMAND_AI_SUMMARY=false
